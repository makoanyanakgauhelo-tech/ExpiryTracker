<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Change Server= if your SQL Server instance has a different name. -->
    <add name="ExpiryDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=ExpiryTrackerDb;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Managers are alerted this many days before expiry. -->
    <add key="AlertDaysBeforeExpiry" value="14" />
    <!-- Optional email alerts: leave ManagerEmail empty to switch email off. -->
    <add key="ManagerEmail" value="" />
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="" />
    <add key="SmtpPassword" value="" />
  </appSettings>
</configuration>
